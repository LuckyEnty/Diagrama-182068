block-beta
  columns 6

  %% Encabezados de Columnas / Tracks Funcionales
  c_crm["<b>CRM / SRM</b>"]
  c_sales["<b>Sales</b>"]
  c_purch["<b>Purchasing</b>"]
  c_inv_prod["<b>Inventory & Production</b>"]
  c_fin["<b>Finance & Accounting</b>"]
  c_serv_rep["<b>Service & Reporting</b>"]

  %% Fila 1: Maestros / Orígenes
  bp_act["Activities"]
  lead["Lead / Customer"]
  item_m["Item Master"]
  bom["Bill of Materials"]
  coa["Chart of Accounts"]
  eq_card["Equipment Card"]

  %% Fila 2: Planificación y Ofertas
  opp["Opportunity"]
  sq["Sales Quotation"]
  pr["Purchase Request"]
  mrp["MRP / Sourcing"]
  gla["G/L Accounts"]
  serv_call["Service Call"]

  %% Fila 3: Órdenes y Contratos
  so["Sales Order"]
  pq["Purchase Quotation"]
  po["Purchase Order"]
  prod_ord["Production Order"]
  cost_acc["Cost Accounting"]
  serv_contr["Service Contract"]

  %% Fila 4: Ejecución / Almacén
  dn["Delivery Note"]
  grpo["Goods Receipt PO"]
  wh_m["Warehouse Mgmt"]
  issue_p["Issue to Production"]
  rec_p["Receipt from Production"]
  serv_bill["Service Billing"]

  %% Fila 5: Facturación & Asientos
  ar_inv["AR Invoice"]
  ap_inv["AP Invoice"]
  je["Journal Entries"]
  ap_ar["AP / AR"]
  cash_m["Cash Management"]
  recon["Reconciliation"]

  %% Fila 6: Pagos y Reportería Final
  inc_pay["Incoming Payments"]
  out_pay["Outgoing Payments"]
  rep_inv["Inventory Audit Report"]
  rep_acc["Account Balances"]
  rep_fin["Financial Reporting"]
  rep_prod["Product Reporting"]

  %% Relaciones de Flujo Vertical y Cruzado (Top-to-Bottom Flow)
  bp_act --> lead
  lead --> opp
  opp --> sq
  sq --> so
  so --> dn
  dn --> ar_inv
  ar_inv --> inc_pay

  item_m --> bom
  pr --> pq
  pq --> po
  po --> grpo
  grpo --> ap_inv
  ap_inv --> out_pay

  bom --> mrp
  mrp --> prod_ord
  prod_ord --> issue_p
  issue_p --> rec_p
  rec_p --> rep_prod

  coa --> gla
  gla --> cost_acc
  cost_acc --> je
  dn --> je
  grpo --> je
  je --> ap_ar
  ap_ar --> cash_m
  cash_m --> recon
  recon --> rep_fin

  eq_card --> serv_call
  serv_call --> serv_contr
  serv_contr --> serv_bill
  serv_bill --> ar_inv

  %% Estilos por Módulos
  style c_crm fill:#5ebd3e,stroke:#333,color:#fff
  style c_sales fill:#f58220,stroke:#333,color:#fff
  style c_purch fill:#008fd3,stroke:#333,color:#fff
  style c_inv_prod fill:#5c2d91,stroke:#333,color:#fff
  style c_fin fill:#e30613,stroke:#333,color:#fff
  style c_serv_rep fill:#ffe600,stroke:#333,color:#000
