flowchart TD
    %% Styling Classes according to the legend
    classDef crm fill:#44b029,stroke:#2e7d32,stroke-width:2px,color:#fff;
    classDef sales fill:#f58220,stroke:#d84315,stroke-width:2px,color:#fff;
    classDef purchasing fill:#008fd5,stroke:#0277bd,stroke-width:2px,color:#fff;
    classDef production fill:#5c1d73,stroke:#311b92,stroke-width:2px,color:#fff;
    classDef service fill:#fff200,stroke:#fbc02d,stroke-width:2px,color:#000;
    classDef inventory fill:#706f6f,stroke:#424242,stroke-width:2px,color:#fff;
    classDef finance fill:#e52320,stroke:#b71c1c,stroke-width:2px,color:#fff;
    classDef reporting fill:#d97ee8,stroke:#8e24aa,stroke-width:2px,color:#fff;

    %% -------------------------------------------------------------
    %% SUBGRAPHS / MODULES
    %% -------------------------------------------------------------

    subgraph SUB_CRM ["CRM / SRM"]
        Activities["Activities"]:::crm
        Customer["Customer"]:::crm
        Lead["Lead"]:::crm
        Supplier["Supplier"]:::crm
        BPMaster["Business Partner Master"]:::crm
    end

    subgraph SUB_SERVICE ["Service"]
        CEC["Customer Equipment Card"]:::service
        ServiceCall["Service Call"]:::service
        ServiceContract["Service Contract"]:::service
        ServiceBilling["Service Billing"]:::service
    end

    subgraph SUB_INVENTORY ["Inventory"]
        ItemMaster["Item Master"]:::inventory
        WarehouseMgmt["Warehouse Management"]:::inventory
        DemandPlanning["Demand Planning"]:::inventory
    end

    subgraph SUB_SALES ["Sales"]
        Opportunity["Opportunity"]:::sales
        Pricing["Pricing"]:::sales
        SalesQuotation["Sales Quotation"]:::sales
        SalesOrder["Sales Order"]:::sales
        DeliveryNote["Delivery Note"]:::sales
        ARInvoice["AR Invoice"]:::sales
        IncomingPayments["Incoming Payments"]:::sales
    end

    subgraph SUB_PURCHASING ["Purchasing"]
        PurchaseRequest["Purchase Request"]:::purchasing
        PurchaseQuotation["Purchase Quotation"]:::purchasing
        PurchaseOrder["Purchase Order"]:::purchasing
        GoodsReceiptPO["Goods Receipt PO"]:::purchasing
        APInvoice["AP Invoice"]:::purchasing
        OutgoingPayments["Outgoing Payments"]:::purchasing
    end

    subgraph SUB_PRODUCTION ["Production"]
        MRP["Material Requirements Planning"]:::production
        BOM["Bill of Materials"]:::production
        Sourcing["Sourcing"]:::production
        ProductionOrder["Production Order"]:::production
        IssueToProduction["Issue to Production"]:::production
        ReceiptFromProduction["Receipt from Production"]:::production
    end

    subgraph SUB_FINANCE ["Finance"]
        COA["Chart of Accounts"]:::finance
        GLAccounts["General Ledger Accounts"]:::finance
        GLAccountDet["G/L Account Determination"]:::finance
        CostAccounting["Cost Accounting"]:::finance
        InventoryAuditReport["Inventory Audit Report"]:::finance
        JournalEntries["Journal Entries"]:::finance
        AP_AR["AP / AR"]:::finance
        CashManagement["Cash Management"]:::finance
        Reconciliation["Reconciliation"]:::finance
        FinancialReporting["Financial Reporting"]:::finance
    end

    subgraph SUB_REPORTING ["Reporting"]
        BackorderReporting["Backorder Reporting"]:::reporting
        AccountBalances["Account Balances Report"]:::reporting
        ProductReporting["Product Reporting"]:::reporting
    end

    %% -------------------------------------------------------------
    %% CRM Flow
    %% -------------------------------------------------------------
    Activities --> Customer
    Customer --> Lead
    Lead --> Supplier
    Supplier --> BPMaster

    %% -------------------------------------------------------------
    %% Service Flow
    %% -------------------------------------------------------------
    CEC --> ServiceCall
    ServiceCall --> ServiceContract
    ServiceContract --> ServiceBilling

    %% -------------------------------------------------------------
    %% Sales Flow
    %% -------------------------------------------------------------
    Customer --> Opportunity
    Opportunity --> Pricing
    Pricing --> SalesQuotation
    SalesQuotation --> SalesOrder
    SalesOrder --> DeliveryNote
    DeliveryNote --> ARInvoice
    ARInvoice --> IncomingPayments

    %% -------------------------------------------------------------
    %% Purchasing Flow
    %% -------------------------------------------------------------
    PurchaseRequest --> PurchaseQuotation
    PurchaseQuotation --> PurchaseOrder
    PurchaseOrder --> GoodsReceiptPO
    GoodsReceiptPO --> APInvoice
    APInvoice --> OutgoingPayments

    %% -------------------------------------------------------------
    %% Production Flow
    %% -------------------------------------------------------------
    BOM --> MRP
    MRP --> Sourcing
    Sourcing --> ProductionOrder
    ProductionOrder --> IssueToProduction
    IssueToProduction --> ReceiptFromProduction

    %% -------------------------------------------------------------
    %% Inventory Flow
    %% -------------------------------------------------------------
    CEC --- ItemMaster
    Pricing --- ItemMaster
    ItemMaster --> WarehouseMgmt
    WarehouseMgmt --> SalesOrder
    SalesOrder --- PurchaseOrder
    PurchaseOrder --- ProductionOrder
    ProductionOrder --> DemandPlanning

    %% -------------------------------------------------------------
    %% Finance Flow
    %% -------------------------------------------------------------
    COA --> GLAccounts
    GLAccounts --> GLAccountDet
    GLAccountDet --> CostAccounting
    CostAccounting --> InventoryAuditReport
    InventoryAuditReport --> JournalEntries
    DeliveryNote -- "Financial Postings" --> JournalEntries
    IssueToProduction -- "Financial Postings" --> JournalEntries
    JournalEntries --> AP_AR
    AP_AR --> CashManagement
    CashManagement --> Reconciliation
    Reconciliation --> FinancialReporting

    %% -------------------------------------------------------------
    %% Reporting Flow & Secondary Cross Connections
    %% -------------------------------------------------------------
    ProductionOrder -.-> BackorderReporting
    DemandPlanning --> BackorderReporting
    BackorderReporting --> AccountBalances
    ReceiptFromProduction --> ProductReporting
    AccountBalances --> ProductReporting
    FinancialReporting --> ProductReporting

    %% Additional Cross-module links (dotted & solid)
    Customer -.-> CEC
    Lead -.-> PurchaseQuotation
    Supplier -.-> Sourcing
    Sourcing -.-> PurchaseQuotation
    ServiceBilling -.-> ARInvoice
    JournalEntries -.-> AccountBalances
    AP_AR -.-> ARInvoice
    AP_AR -.-> APInvoice
    CashManagement -.-> IncomingPayments
    CashManagement -.-> OutgoingPayments
    BOM -.-> GLAccounts
